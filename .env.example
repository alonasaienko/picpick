# Приклад змінних для compose.yaml. Скопіюйте у .env і змініть паролі:
#   cp .env.example .env
# .env у .gitignore і ніколи не комітиться. Тут лише приклади, не справжні паролі.

# PostgreSQL
POSTGRES_DB=picpick
POSTGRES_USER=picpick
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# RabbitMQ (не використовуйте стандартний guest)
RABBITMQ_USER=picpick
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# MinIO (пароль щонайменше 8 символів; не використовуйте стандартний minioadmin)
MINIO_ROOT_USER=picpick
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
