@page
@model ErrorModel
@{
    ViewData["Title"] = "Помилка";
}

<div class="container">
    <div class="card-soft placeholder-card">
        <h1 class="h3">Щось пішло не так</h1>
        <p class="mb-4">Не вдалося обробити запит. Спробуйте пізніше.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small">Код запиту: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-page="/Index">На головну</a>
    </div>
</div>
