@page
@{
    ViewData["Title"] = "Мої галереї";
}

<section class="section py-0" data-sparkles="14" data-sparkles-soft>
    <div class="container">
        <div class="card-soft placeholder-card">
            <span class="step-number step-1">&#9829;</span>
            <h1 class="h3 mt-3">Мої галереї</h1>
            <p class="mb-4">Сторінка в розробці. Тут з'являться ваші галереї та кнопка створення нової.</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-primary" href="/Galleries/Create">Створити галерею</a>
                <a class="btn btn-outline-theme" asp-page="/Index">На головну</a>
            </div>
        </div>
    </div>
</section>
